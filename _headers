# Global security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# HTML: revalidate + unified CSP (union of index/blogs/forms/audio needs; meta CSP removed from pages)
**/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; worker-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; connect-src 'self' https://abacus.jasoncameron.dev https://bible-api.com https://api.allorigins.win https://corsproxy.io https://bible.helloao.org https://www.google-analytics.com https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://awfgsa.blogspot.com https://api.codetabs.com; img-src 'self' data: https:; media-src 'self' https://*.r2.dev blob:; frame-src https://www.youtube.com; form-action 'self' https://formspree.io; base-uri 'self'; manifest-src 'self'; object-src 'none'

# Long cache for static assets (sw.js excluded — rule below overrides **/*.js)
**/*.css
  Cache-Control: public, max-age=31536000, immutable
**/*.js
  Cache-Control: public, max-age=31536000, immutable

# Service worker must update quickly (must come after **/*.js so it wins on Pages)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
**/*.png
  Cache-Control: public, max-age=31536000, immutable
**/*.jpg
  Cache-Control: public, max-age=31536000, immutable
**/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
**/*.gif
  Cache-Control: public, max-age=31536000, immutable
**/*.svg
  Cache-Control: public, max-age=31536000, immutable
**/*.webp
  Cache-Control: public, max-age=31536000, immutable
**/*.ico
  Cache-Control: public, max-age=31536000, immutable
**/*.woff2
  Cache-Control: public, max-age=31536000, immutable
**/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/blog-feed.json
  Cache-Control: public, max-age=300, must-revalidate
