# Optional: copy to wrangler.toml on your machine for LOCAL preview only:
#   npx wrangler pages dev . --compatibility-date=2024-11-01
# Do NOT commit wrangler.toml if Cloudflare Pages mis-detects Workers.
# In the Pages dashboard: Build command MUST be empty (never "npx wrangler deploy").

name = "faith-driven-life"
compatibility_date = "2024-11-01"
pages_build_output_dir = "."
